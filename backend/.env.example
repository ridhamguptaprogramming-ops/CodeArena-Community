PORT=8080
CODEARENA_SANDBOX_IMAGE=codearena/sandbox:latest
DOCKER_COMMAND=docker
EXECUTION_TEMP_ROOT=/tmp/codearena-executions
EXECUTION_TIMEOUT_SECONDS=5
COMPILE_TIMEOUT_SECONDS=25
MAX_SOURCE_BYTES=131072
MAX_STDIN_BYTES=65536
MAX_OUTPUT_BYTES=1048576
MAX_PARALLEL_EXECUTIONS=4
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173,https://codearena-compiler.vercel.app

# Reserved for the assessment platform phase; database and queue features are not implemented yet.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
JWT_SECRET=
REDIS_URL=
RABBITMQ_URL=
